# Copier en ".env" pour le développement local, ou en ".env.production" pour un build
# de production ("npm run build" charge automatiquement .env.production s'il existe).

# URL de base de l'API backend, AVEC le préfixe /api.
# Développement local :
VITE_API_URL=http://localhost:8081/api
# Production (domaine officiel spartakbrico.com) :
# VITE_API_URL=https://api.spartakbrico.com/api

# ID du Pixel Meta (Facebook Ads), pour le suivi des visites et des événements
# e-commerce (vue produit, ajout panier, démarrage commande, achat) utilisés par les
# campagnes publicitaires. Visible dans Gestionnaire d'événements -> Pixels, sur
# business.facebook.com. Laisser vide pour désactiver le suivi (ex: en développement).
VITE_FACEBOOK_PIXEL_ID=

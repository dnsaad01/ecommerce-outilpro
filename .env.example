# =============================================================================
# Exemple de configuration -- copier ce fichier en ".env" (jamais commité, voir
# .gitignore) et renseigner de VRAIES valeurs. Les valeurs ci-dessous sont des
# exemples de démonstration, PAS des secrets à réutiliser tels quels.
#
# Ce fichier sert à la fois :
#  - à docker-compose.yml (variables DB_*) pour la base Postgres locale ;
#  - au backend Spring Boot (variables lues via ${VAR:defaut} dans
#    application.properties, ou ${VAR} sans défaut dans application-prod.properties).
# =============================================================================

# --- Base de données locale (docker-compose) ---
DB_NAME=outilpro
DB_USER=outilpro
DB_PASSWORD=outilpro
DB_PORT=5435

# --- Connexion Spring Boot à la base de données ---
# En local, les défauts d'application.properties pointent déjà vers le conteneur
# docker-compose ci-dessus -- ces 3 lignes ne sont nécessaires que pour un
# environnement différent (ex: prod, ou une base déjà existante).
# SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5435/outilpro?ssl=false&prepareThreshold=0
# SPRING_DATASOURCE_USERNAME=outilpro
# SPRING_DATASOURCE_PASSWORD=outilpro

# --- JWT ---
# Générer avec : openssl rand -base64 32
JWT_SECRET=REMPLACER_PAR_UN_SECRET_GENERE_ALEATOIREMENT
JWT_EXPIRATION_MS=7200000

# --- Comptes admin/employé créés automatiquement au premier démarrage ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_FORT
EMPLOYE_USERNAME=employe
EMPLOYE_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_FORT

# --- CORS : origine(s) autorisée(s) à appeler l'API ---
# Développement local :
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Production (déjà le défaut dans application-prod.properties, à ne définir ici que
# pour le surcharger) :
# CORS_ALLOWED_ORIGINS=https://spartakbrico.com,https://www.spartakbrico.com

# --- Notification Telegram a l'equipe admin lors d'une nouvelle commande (optionnel) ---
# Laisser vide/absent desactive simplement la notification, aucune erreur generee.
# 1. Cree un bot via @BotFather sur Telegram, recupere son token.
# 2. Recupere l'ID du chat (prive ou groupe) qui doit recevoir les notifications.
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVwxYZ
# TELEGRAM_CHAT_ID=123456789

# --- URL publique du backend (liens d'images uploadées) ---
# Développement local :
APP_BASE_URL=http://localhost:8081
# Production (déjà le défaut dans application-prod.properties) :
# APP_BASE_URL=https://api.spartakbrico.com

# =============================================================================
# Les variables suivantes ont déjà un défaut raisonnable en local -- à ne définir
# ici que pour les surcharger (prod, ou test d'un réglage différent) :
#
# SERVER_PORT=8081
# APP_UPLOAD_DIR=uploads
# STOCK_SEUIL_ALERTE=5
# RATE_LIMIT_GLOBAL_CAPACITY=300
# RATE_LIMIT_GLOBAL_WINDOW=60
# RATE_LIMIT_LOGIN_CAPACITY=5
# RATE_LIMIT_LOGIN_WINDOW=60
# RATE_LIMIT_COMMANDE_CAPACITY=10
# RATE_LIMIT_COMMANDE_WINDOW=60
# RATE_LIMIT_PROMO_CAPACITY=15
# RATE_LIMIT_PROMO_WINDOW=60
#
# --- Active le profil de production (voir application-prod.properties) ---
# Ne JAMAIS mettre cette ligne dans le .env local -- uniquement sur le serveur de
# prod (variable d'environnement du système/conteneur, pas ce fichier).
# SPRING_PROFILES_ACTIVE=prod
# =============================================================================
